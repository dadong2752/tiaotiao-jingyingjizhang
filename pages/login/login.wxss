.container {
  min-height: 100vh;
  background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
  padding: 40rpx;
  display: flex;
  flex-direction: column;
}

.logo {
  text-align: center;
  padding: 80rpx 0 60rpx;
}

.title {
  display: block;
  font-size: 48rpx;
  font-weight: bold;
  color: #fff;
  margin-bottom: 16rpx;
}

.subtitle {
  display: block;
  font-size: 28rpx;
  color: rgba(255,255,255,0.8);
}

.form {
  background: #fff;
  border-radius: 24rpx;
  padding: 48rpx 32rpx;
  box-shadow: 0 20rpx 40rpx rgba(0,0,0,0.1);
}

.form-item {
  margin-bottom: 32rpx;
}

.form-item input {
  height: 88rpx;
  background: #f5f6fa;
  border-radius: 12rpx;
  padding: 0 24rpx;
  font-size: 28rpx;
}

.btn-area {
  margin-top: 24rpx;
}

.btn-area button {
  height: 88rpx;
  background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
  color: #fff;
  border-radius: 44rpx;
  font-size: 32rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.btn-area button[disabled] {
  background: #ccc;
  color: #fff;
}

.wechat-btn {
  background: #07c160 !important;
}

.divider {
  text-align: center;
  margin: 32rpx 0;
  color: #999;
  font-size: 24rpx;
  display: flex;
  align-items: center;
}

.divider::before,
.divider::after {
  content: '';
  flex: 1;
  height: 1rpx;
  background: #eee;
}

.divider text {
  padding: 0 24rpx;
}

.footer {
  display: flex;
  justify-content: center;
  margin-top: 48rpx;
  color: #fff;
  font-size: 26rpx;
}

.footer text {
  padding: 0 16rpx;
}

.footer .split {
  color: rgba(255,255,255,0.5);
}