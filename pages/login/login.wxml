<view class="container">
  <view class="logo">
    <text class="title">跳跳经营记账</text>
    <text class="subtitle">轻松管理每一笔收支</text>
  </view>

  <view class="form">
    <view class="form-item">
      <input type="number" placeholder="请输入手机号" maxlength="11" bindinput="onPhoneInput" value="{{phone}}" />
    </view>
    <view class="form-item">
      <input password="true" placeholder="请输入密码" bindinput="onPasswordInput" value="{{password}}" />
    </view>

    <view class="btn-area">
      <button type="primary" bindtap="onLogin" disabled="{{!canLogin}}">登录</button>
    </view>

    <view class="divider">
      <text>或</text>
    </view>

    <view class="btn-area">
      <button open-type="getPhoneNumber" bindgetphonenumber="onGetPhoneNumber" class="wechat-btn">微信一键登录</button>
    </view>
  </view>

  <view class="footer">
    <text bindtap="onForgotPassword">忘记密码</text>
    <text class="split">|</text>
    <text bindtap="onRegister">注册账号</text>
  </view>
</view>