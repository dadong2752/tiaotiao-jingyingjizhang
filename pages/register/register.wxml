<view class="container">
  <view class="header">
    <text class="title">创建账号</text>
    <text class="desc">注册后即可使用手机号登录</text>
  </view>

  <view class="form">
    <view class="form-item">
      <view class="label">手机号</view>
      <input type="number" placeholder="请输入手机号" maxlength="11" bindinput="onPhoneInput" value="{{phone}}" />
    </view>

    <view class="form-item">
      <view class="label">设置密码</view>
      <input password="true" placeholder="至少6位" bindinput="onPasswordInput" value="{{password}}" />
    </view>

    <view class="form-item">
      <view class="label">邮箱（找回密码用）</view>
      <input type="text" placeholder="选填" bindinput="onEmailInput" value="{{email}}" />
    </view>

    <view class="btn-area">
      <button type="primary" bindtap="onRegister" disabled="{{!canRegister}}">注册</button>
    </view>

    <view class="agreement">
      <text>注册即表示同意</text>
      <text class="link">《用户协议》</text>
    </view>
  </view>

  <view class="footer">
    <text>已有账号？</text>
    <text class="link" bindtap="onGoLogin">立即登录</text>
  </view>
</view>